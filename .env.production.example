# Production Environment Variables
# Copy this file to .env.production and fill in the values

# Database Configuration
DB_USER=postgres
DB_PASSWORD=your-secure-db-password-here
DB_NAME=saas_prod
DATABASE_URL=postgresql://postgres:your-secure-db-password-here@postgres:5432/saas_prod

# JWT Configuration
JWT_ACCESS_SECRET=your-very-long-access-secret-key-min-32-chars
JWT_REFRESH_SECRET=your-very-long-refresh-secret-key-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=7

# CORS Configuration
CORS_ORIGIN=https://your-domain.com

# Analytics Service
ANALYTICS_SERVICE_URL=http://analytics:8000
ANALYTICS_ORG_SYNC_INTERVAL_MS=86400000

# Super Admin Configuration
SUPER_ADMIN_EMAIL=admin@your-domain.com
SUPER_ADMIN_PASSWORD=your-strong-super-admin-password

# Node Environment
NODE_ENV=production
PORT=4000

# Logging
LOG_LEVEL=info

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
