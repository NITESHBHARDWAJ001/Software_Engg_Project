generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id              String                     @id @default(uuid())
  name            String
  slug            String                     @unique
  email           String?
  phone           String?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
  customers       Customer[]
  exhibitions     Exhibition[]
  exhibitionLeads ExhibitionLead[]
  inventoryItems  InventoryItem[]
  invoices        Invoice[]
  ledgerEntries   LedgerEntry[]
  subscriptions   OrganizationSubscription[]
  tasks           Task[]
  users           User[]
}

model User {
  id                      String            @id @default(uuid())
  email                   String            @unique
  passwordHash            String
  firstName               String
  lastName                String
  role                    Role              @default(STAFF)
  isActive                Boolean           @default(true)
  organizationId          String?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  createdExhibitions      Exhibition[]      @relation("ExhibitionCreatedBy")
  capturedExhibitionLeads ExhibitionLead[]  @relation("ExhibitionLeadCapturedBy")
  leadInteractions        LeadInteraction[]
  refreshSessions         RefreshSession[]
  assignedTasks           Task[]            @relation("TaskAssignedTo")
  createdTasks            Task[]            @relation("TaskCreatedBy")
  taskComments            TaskComment[]
  organization            Organization?     @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([role])
}

model RefreshSession {
  id          String   @id @default(uuid())
  userId      String
  tokenHash   String
  tokenFamily String
  isRevoked   Boolean  @default(false)
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenFamily])
}

model Customer {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  email          String?
  phone          String?
  city           String?
  country        String?
  totalSpent     Decimal      @default(0)
  lifetimeValue  Decimal      @default(0)
  isArchived     Boolean      @default(false)
  createdBy      String?
  updatedBy      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tasks          Task[]

  @@index([organizationId])
  @@index([organizationId, name])
  @@index([organizationId, isArchived])
}

model InventoryItem {
  id             String              @id @default(uuid())
  organizationId String
  name           String
  sku            String
  category       String
  currentStock   Int                 @default(0)
  reorderLevel   Int                 @default(0)
  minStockLevel  Int                 @default(0)
  unitPrice      Decimal             @default(0)
  sellingPrice   Decimal             @default(0)
  unit           String              @default("piece")
  status         InventoryStatus     @default(IN_STOCK)
  createdBy      String?
  updatedBy      String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  movements      InventoryMovement[]

  @@unique([organizationId, sku])
  @@index([organizationId, category])
  @@index([organizationId, status])
}

model InventoryMovement {
  id             String        @id @default(uuid())
  organizationId String
  itemId         String
  changeType     String
  quantity       Int
  note           String?
  createdBy      String?
  createdAt      DateTime      @default(now())
  item           InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([organizationId, itemId])
  @@index([createdAt])
}

model SubscriptionPlan {
  id            String                     @id @default(uuid())
  name          String
  code          String                     @unique
  description   String?
  billingCycle  PlanBillingCycle
  price         Decimal                    @default(0)
  currency      String                     @default("USD")
  isActive      Boolean                    @default(true)
  features      String[]
  limits        Json?
  createdBy     String?
  updatedBy     String?
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt
  subscriptions OrganizationSubscription[]

  @@index([isActive])
}

model OrganizationSubscription {
  id               String             @id @default(uuid())
  organizationId   String
  planId           String
  status           SubscriptionStatus @default(ACTIVE)
  startDate        DateTime
  endDate          DateTime?
  trialEndsAt      DateTime?
  canceledAt       DateTime?
  autoRenew        Boolean            @default(true)
  seats            Int?
  includedFeatures String[]
  excludedFeatures String[]
  metadata         Json?
  createdBy        String?
  updatedBy        String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan             SubscriptionPlan   @relation(fields: [planId], references: [id])

  @@index([organizationId, status])
  @@index([organizationId, startDate])
  @@index([planId])
}

model Invoice {
  id             String        @id @default(uuid())
  organizationId String
  invoiceNumber  String
  status         InvoiceStatus @default(DRAFT)
  issueDate      DateTime
  dueDate        DateTime?
  paidAt         DateTime?
  currency       String        @default("USD")
  subtotal       Decimal       @default(0)
  taxAmount      Decimal       @default(0)
  discountAmount Decimal       @default(0)
  totalAmount    Decimal       @default(0)
  notes          String?
  createdBy      String?
  updatedBy      String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ledgerEntries  LedgerEntry[]

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId, status])
  @@index([organizationId, issueDate])
}

model LedgerEntry {
  id             String          @id @default(uuid())
  organizationId String
  invoiceId      String?
  type           LedgerEntryType
  amount         Decimal
  entryDate      DateTime
  category       String?
  description    String?
  createdBy      String?
  createdAt      DateTime        @default(now())
  invoice        Invoice?        @relation(fields: [invoiceId], references: [id])
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, type])
  @@index([organizationId, entryDate])
  @@index([invoiceId])
}

model Task {
  id                  String        @id @default(uuid())
  organizationId      String
  title               String
  description         String        @default("")
  status              TaskStatus    @default(TODO)
  priority            TaskPriority  @default(MEDIUM)
  assignedTo          String?
  createdBy           String
  dueDate             DateTime?
  completedAt         DateTime?
  tags                String[]
  attachments         String[]
  relatedExhibitionId String?
  relatedCustomerId   String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  assignedToUser      User?         @relation("TaskAssignedTo", fields: [assignedTo], references: [id])
  createdByUser       User          @relation("TaskCreatedBy", fields: [createdBy], references: [id], onDelete: Cascade)
  organization        Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  relatedCustomer     Customer?     @relation(fields: [relatedCustomerId], references: [id])
  relatedExhibition   Exhibition?   @relation(fields: [relatedExhibitionId], references: [id])
  comments            TaskComment[]

  @@index([organizationId, status])
  @@index([organizationId, priority])
  @@index([organizationId, assignedTo])
  @@index([organizationId, dueDate])
}

model TaskComment {
  id        String   @id @default(uuid())
  taskId    String
  userId    String
  content   String
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@index([userId])
}

model Exhibition {
  id               String           @id @default(uuid())
  organizationId   String
  name             String
  description      String           @default("")
  location         String
  startDate        DateTime
  endDate          DateTime
  status           ExhibitionStatus @default(UPCOMING)
  budget           Decimal          @default(0)
  actualSpent      Decimal          @default(0)
  expectedRevenue  Decimal          @default(0)
  actualRevenue    Decimal          @default(0)
  expectedFootfall Int?
  actualFootfall   Int?
  boothSize        String?
  stallNumber      String?
  category         String?
  assignedStaff    String[]
  totalLeads       Int              @default(0)
  convertedLeads   Int              @default(0)
  createdBy        String
  notes            String?
  images           String[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  createdByUser    User             @relation("ExhibitionCreatedBy", fields: [createdBy], references: [id], onDelete: Cascade)
  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leads            ExhibitionLead[]
  tasks            Task[]

  @@index([organizationId, status])
  @@index([organizationId, startDate])
  @@index([organizationId, endDate])
}

model ExhibitionLead {
  id                 String            @id @default(uuid())
  exhibitionId       String
  organizationId     String
  name               String
  phone              String
  email              String?
  company            String?
  interestLevel      LeadInterestLevel @default(COLD)
  status             LeadStatus        @default(NEW)
  interestedProducts String[]
  notes              String?
  capturedBy         String
  capturedAt         DateTime          @default(now())
  followUpDate       DateTime?
  lastContactedDate  DateTime?
  source             LeadSource        @default(EXHIBITION)
  estimatedValue     Decimal?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  capturedByUser     User              @relation("ExhibitionLeadCapturedBy", fields: [capturedBy], references: [id], onDelete: Cascade)
  exhibition         Exhibition        @relation(fields: [exhibitionId], references: [id], onDelete: Cascade)
  organization       Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  interactions       LeadInteraction[]

  @@index([organizationId, exhibitionId])
  @@index([organizationId, status])
  @@index([organizationId, interestLevel])
}

model LeadInteraction {
  id        String              @id @default(uuid())
  leadId    String
  userId    String
  type      LeadInteractionType
  notes     String
  createdAt DateTime            @default(now())
  lead      ExhibitionLead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
  @@index([userId])
}

enum Role {
  SUPER_ADMIN
  ORG_ADMIN
  STAFF
}

enum InventoryStatus {
  IN_STOCK
  LOW_STOCK
  CRITICAL
  OUT_OF_STOCK
}

enum InvoiceStatus {
  DRAFT
  PENDING
  PAID
  OVERDUE
}

enum LedgerEntryType {
  INCOME
  EXPENSE
  ADJUSTMENT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ExhibitionStatus {
  UPCOMING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum LeadInterestLevel {
  COLD
  WARM
  HOT
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  NEGOTIATION
  CONVERTED
  LOST
}

enum LeadSource {
  EXHIBITION
  REFERRAL
  WEBSITE
  OTHER
}

enum LeadInteractionType {
  CALL
  EMAIL
  MEETING
  NOTE
}

enum PlanBillingCycle {
  MONTHLY
  QUARTERLY
  YEARLY
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}
