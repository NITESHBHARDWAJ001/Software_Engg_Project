# Normalize line endings in the repository
* text=auto

# Keep Python source files with LF line endings
*.py text eol=lf

# Frontend source files
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.css text eol=lf
*.html text eol=lf

# Text-based control files and docs should also use LF
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
